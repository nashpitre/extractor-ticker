{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nashp-extractor-ticker-example",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "EXTRACTOR_ARCHIVE",
        "class_name": "ExtractorArchive"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExtractorArchive"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
